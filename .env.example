# Copy this file to .env and fill in the values. Never commit the .env file.

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Required. A long random value (for example: openssl rand -base64 48).
# The server refuses to start without it.
JWT_SECRET=

# Optional. Addresses of your sites, separated by commas.
# When empty, any website may call the API from a browser.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Used by the live notifications (WebSocket) and the e-mail alerts
FRONTEND_URL=http://localhost:3001
ADMIN_EMAIL=admin@example.com

# Optional. Default is 3000.
PORT=3000
