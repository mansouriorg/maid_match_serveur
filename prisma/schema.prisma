// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"

}

datasource db {
  provider = "postgresql"
}

// 1. Service Request Model
model ServiceRequest {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Customer Info (Matches React StepContact)
  customerName  String
  customerEmail String
  customerPhone String
  
  // Property Info (Matches React StepProperty)
  address       String
  propertyType  String   // apartment, villa, studio
  rooms         Int
  bathrooms     Int
  cleaningType  String   // standard, deep
  hasSupplies   Boolean
  extras        String[] // Array for ["ironing", "pets", etc]

  // Schedule Info (Matches React StepSchedule)
  startTime     DateTime
  durationHours Int
  frequency     String   // one-time, weekly, etc
  
  // Admin Status
  status        String   @default("REQUESTED") // REQUESTED, CONFIRMED, ASSIGNED, COMPLETED

  // Relation: Link a Maid to this request (Optional until assigned)
  maidId        Int?
  maid          Maid?    @relation(fields: [maidId], references: [id])

  // Le prix total calculé pour la réservation
  totalPrice    Float    @default(0.0)
}

// 2. ENHANCED Maid Model
model Maid {
  id              Int              @id @default(autoincrement())
  createdAt       DateTime         @default(now())
  
  // Basic Info
  fullName        String
  phoneNumber     String
  profilePicture  String?          // URL to image (optional)

  // Professional Details
  specialty       String           // e.g., "Cleaning", "Nanny", "Deep Clean Expert"
  experienceYears Int              @default(0) // How long they have been working
  bio             String?          // e.g. "Hardworking and detail-oriented with 5 years experience."
  
  // Skills & Logistics
  languages       String[]         // e.g. ["Arabic", "French"]
  
  // Quality & Trust
  rating          Float            @default(5.0) // 0.0 to 5.0 stars
  isVerified      Boolean          @default(false) // Have you checked their ID/CIN?
  
  // Status
  status          String           @default("AVAILABLE") // AVAILABLE, BUSY, ON_LEAVE
  
  // Relation back to requests
  requests        ServiceRequest[]
}

// 3. NEW Admin Model (For your Dashboard Login)
model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Will store hashed password
  createdAt DateTime @default(now())
}

// 4. NEW Notification Model (For Dashboard Real-time Alerts)
model Notification {
  id               Int      @id @default(autoincrement())
  title            String
  message          String
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())
  
  // Save the ID of the related request so we can click on it!
  serviceRequestId Int?     
}

// 5. NEW Settings Model (Global Configuration)
model Settings {
  id                Int      @id @default(1)
  firstName         String   @default("Mahmoud")
  lastName          String   @default("Mansouri")
  email             String   @default("admin@nobreach.com")
  companyName       String   @default("No Breach")
  contactPhone      String   @default("+216 55 123 456")
  defaultHourlyRate Float    @default(15.0)
  emailAlerts       Boolean  @default(true)
  smsAlerts         Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}