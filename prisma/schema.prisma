// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"

}

datasource db {
  provider = "postgresql"
}

model ServiceRequest {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Contact Info
  fullName    String
  phoneNumber String
  address     String?

  // Service Details
  serviceType String   // e.g., 'Cleaning', 'Babysitting'
  startTime   DateTime // The requested date/time
  duration    Int      // In hours
  notes       String?
  
  // Admin Status
  status      String   @default("PENDING") // PENDING, CONTACTED, ASSIGNED
}

model Maid {
  id          Int      @id @default(autoincrement())
  fullName    String
  phoneNumber String
  specialty   String   // e.g., "Cleaning", "Nanny"
  // Relation to requests (optional, but good for history)
  // requests ServiceRequest[] 
}

// Add this to your schema.prisma
model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Will store hashed password (e.g., $2b$10$...)
  createdAt DateTime @default(now())
}