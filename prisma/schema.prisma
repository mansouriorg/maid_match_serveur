// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"

}

datasource db {
  provider = "postgresql"
}
model ServiceRequest {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Customer Info (Matches React StepContact)
  customerName  String
  customerEmail String
  customerPhone String
  
  // Property Info (Matches React StepProperty)
  address       String
  propertyType  String   // apartment, villa, studio
  rooms         Int
  bathrooms     Int
  cleaningType  String   // standard, deep
  hasSupplies   Boolean
  extras        String[] // Array for ["ironing", "pets", etc]

  // Schedule Info (Matches React StepSchedule)
  startTime     DateTime
  durationHours Int
  frequency     String   // one-time, weekly, etc
  
  // Admin Status
  status        String   @default("REQUESTED") // REQUESTED, CONFIRMED, ASSIGNED, COMPLETED

  // Relation: Link a Maid to this request (Optional until assigned)
  maidId        Int?
  maid          Maid?    @relation(fields: [maidId], references: [id])
}

// 2. NEW Maid Model (For your future dispatching)
model Maid {
  id          Int              @id @default(autoincrement())
  fullName    String
  phoneNumber String
  specialty   String           // e.g., "Cleaning", "Nanny"
  status      String           @default("AVAILABLE") // AVAILABLE, BUSY
  
  // Relation back to requests
  requests    ServiceRequest[]
}

// 3. NEW Admin Model (For your Dashboard Login)
model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Will store hashed password
  createdAt DateTime @default(now())
}